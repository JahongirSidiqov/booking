DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local run against the Docker db service. POSTGRES_PORT is the host port
# docker compose publishes (change it if 5432 is already taken locally).
# Inside docker compose the web service overrides host to "db".
DATABASE_URL=postgres://navbat:navbat@localhost:5432/navbat
POSTGRES_DB=navbat
POSTGRES_USER=navbat
POSTGRES_PASSWORD=navbat
POSTGRES_PORT=5432

DEFAULT_TZ=Asia/Tashkent

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Navbat <no-reply@navbat.uz>
