# Copy to .env.prod on the server. Never commit the real file.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=navbat.example.uz
CSRF_TRUSTED_ORIGINS=https://navbat.example.uz
SITE_URL=https://navbat.example.uz
DOMAIN=navbat.example.uz

POSTGRES_DB=navbat
POSTGRES_USER=navbat
POSTGRES_PASSWORD=generate-a-strong-password

DEFAULT_TZ=Asia/Tashkent
# One proxy (Caddy / Render / Railway) in front of gunicorn: throttling uses the real client IP.
NUM_PROXIES=1
GUNICORN_WORKERS=3
EXPIRE_INTERVAL_SECONDS=300

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.uz
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Navbat <no-reply@navbat.example.uz>

# Demo deployments only: password for `manage.py seed_demo` accounts.
DEMO_PASSWORD=Navbat-Demo-2026
